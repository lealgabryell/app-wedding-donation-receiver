PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Server-only. Use an Atlas replica set or a local MongoDB replica set.
MONGODB_URI=
MONGODB_DB=wedding
# Random secret used by Vercel Cron (Authorization: Bearer <secret>).
CRON_SECRET=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Public HTTPS address ending in /api/webhooks/mercadopago (required for payments).
MERCADO_PAGO_NOTIFICATION_URL=
