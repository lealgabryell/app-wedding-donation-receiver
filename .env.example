PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Server-only. Use an Atlas replica set or a local MongoDB replica set.
MONGODB_URI=
MONGODB_DB=wedding
# Random secret used by Vercel Cron (Authorization: Bearer <secret>).
CRON_SECRET=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
# Secret signature of the webhook configured in the Mercado Pago panel ("Order" event,
# URL https://<domain>/api/webhooks/mercadopago). Orders API has no per-order notification URL.
MERCADO_PAGO_WEBHOOK_SECRET=
# Optional. Card statement text (max 22 chars, no accents). Default: MALU E GABRYELL
MERCADO_PAGO_STATEMENT_DESCRIPTOR=
